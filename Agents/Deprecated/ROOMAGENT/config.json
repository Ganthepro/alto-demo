    "room_rule": {                          #rule set

        "room_check_in": {                  #header1 command
            "fan": {                        #device want to command
                "header": "controlfan",     #header1 for send to device
                "message":{                 #message1 to send to device
                    "1": "on"
                }
            },
            "light": {
                "header": "controllight",
                "message": {
                    "1": "on",
                    "2": "on",
                    "3": "on"
                }
            },
            "light1": {
                "header": "controllight1",
                "message": {
                    "1": "on",
                    "2": "on",
                    "3": "on"
                }
            },
            "ac": {
                "header": "controlac",
                "message": {}
            },
            "sensor_environment": {
                "header": "setupenv",
                "message": {
                    "device_monitor_time": "20"
                }
            }
        },

        "room_check_out": {
            "fan": {
                "header": "controlfan",
                "message": {
                    "1": "off"
                }
            },
            "light": {
                "header": "controllight",
                "message": {
                    "1": "off",
                    "2": "off",
                    "3": "off"
                }
            },
            "light1": {
                "header": "controllight1",
                "message": {
                    "1": "off",
                    "2": "off",
                    "3": "off"
                }
            },
            "ac": {
                "header": "controlac",
                "message": {}
            },
            "sensor_environment": {
                "header": "setupenv",
                "message": {
                    "device_monitor_time": "60"
                }
            }
        }
    }



